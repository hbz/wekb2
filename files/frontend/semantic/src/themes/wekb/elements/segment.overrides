/*******************************
         Theme Overrides
*******************************/
// wcag
.ui.segment.footer.wekb-footer {
  padding: 40px;
  margin: 0;
  background-color: #f7f8fa;
  border-radius: 0;

  .ui.header,
  .ui.link.list .item,
  .ui.link.list .item a:not(.ui),
  .ui.link.list a.item {
    color: #6f717a;
  }

  .ui.link.list .item,
  .ui.link.list .item a:not(.ui),
  .ui.link.list a.item {
    padding: 5px 0;
  }

  .ui.grid > .column:not(.row) {
    padding-top: 0 !important;
  }
}
/********************************
 * Filter Segment
 ********************************/
.ui.segment.wekb-topFilter {
     background: #ffffff4d;
     border: 2px solid #2e6fd9;
     box-shadow: 0 0.4rem 1.5rem rgba(34, 36, 38, 0.045);
}

@media only screen and (min-width: 1200px) {
    footer .ui.ui.ui.container:not(.fluid) {
        width: 1800px;
    }
}