/*******************************
         Theme Overrides
*******************************/
// wcag
.ui.segment.footer.wekb-footer {
  padding: 40px;
  margin: 0;
  background-color: #f7f8fa;

  .ui.header,
  .ui.link.list .item,
  .ui.link.list .item a:not(.ui),
  .ui.link.list a.item {
    color: #6f717a;
  }

  .ui.link.list .item,
  .ui.link.list .item a:not(.ui),
  .ui.link.list a.item {
    padding: 5px 0;
  }

  .ui.grid > .column:not(.row) {
    padding-top: 0 !important;
  }
}