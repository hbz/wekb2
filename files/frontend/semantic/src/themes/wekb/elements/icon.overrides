/*******************************
         Theme Overrides
*******************************/

// ****  Package **** //
i.inverted.circular.wekb-packages.icon {
    background-color: @package!important ;
    color: #fff!important;
    &:before {
        content: "\f466";
    }
}

// ****  organisation **** //
i.inverted.circular.wekb-org.icon {
    background-color: @org!important ;
    color: #fff!important;
        &:before {
            content: "\f466";
        }
}

