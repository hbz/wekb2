/*******************************
         Theme Overrides
*******************************/

// ****  Package **** //
i.inverted.circular.wekb-package.icon {
    background-color: @package!important ;
    color: #fff!important;
    &:before {
        content: "\f466";
    }
}

// ****  organisation **** //
i.inverted.circular.wekb-org.icon {
    background-color: @org!important ;
    color: #fff!important;
        &:before {
            content: "\f466";
        }
}

// ****  platform **** //
i.inverted.circular.wekb-platform.icon {
    background-color: @platform!important;
    color: #fff!important;
    &:before {
        content: "\f0c2";
    }
}

// ****  Vendor **** //
i.inverted.circular.wekb-vendor.icon {
    background-color: @vendor!important;
    color: #fff!important;
    &:before {
        content: "\f2b5";
    }
}

// ****  Title **** //
i.inverted.circular.wekb-title.icon {
    background-color: @title!important;
    color: #fff!important;
    &:before {
        content: "\f02d";
    }
}

// ****  Provider **** //
i.inverted.circular.wekb-provider.icon {
    background-color: @provider!important;
    color: #fff!important;
        &:before {
            content: "\f519";
        }
}
// ****  Source  **** //
i.inverted.circular.wekb-source.icon {
    background-color: @default!important;
    color: #fff!important;
        &:before {
            content: "\f381";
        }
}

// ****  Default **** //
i.inverted.circular.wekb-default.icon {
    background-color: @default!important;
    color: #fff!important;
        &:before {
            content: "\f15c";
        }
}
// ****  Overview **** //
i.inverted.circular.wekb-overview.icon {
    background-color: @default!important;
    color: #fff!important;
        &:before {
            content: "\f009";
        }
}
// ****  Setting **** //
i.inverted.circular.wekb-setting.icon {
    background-color: @default!important;
    color: #fff!important;
        &:before {
            content: "\f013";
        }
}
// ****  Information **** //
i.inverted.circular.wekb-info.icon {
    background-color: @default!important;
    color: #fff!important;
        &:before {
            content: "\f129";
        }
}

i.inverted.circular.icon::before {
    display: inline-block;
    transform: scale(.75);
    transform-origin: center;
}


