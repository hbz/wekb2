footer {
  h2.ui.header {
    font-size: 1rem;
  }
}
.wekb-inline-lists {
    .wekb-header {
        &:last-child  {
            margin-bottom: 1em;
            display: block;
        }
        &:first-child  {
            margin-top: 1em;
            display: block;
        }
    }
}
/*******************************
         Every view header
*******************************/
@header-icon-size: 3rem;
@header-icon-symbol-size: 1.5rem;
@header-icon-ring-size: .6rem;
/*******************************
         Mixin for header icon
*******************************/
.icon-color-header(@color) {
    background-color: @color !important;

    box-shadow:
        // glow ring
        0 0 0 @header-icon-ring-size fade(@color, 12%);
}

/*******************************
         Mixin for landing page icon
*******************************/
.icon-color-landing(@color) {
    background-color: @color !important;

    box-shadow:
        // glow ring
        0 0 0 @header-icon-ring-size fade(@color, 12%),
        // white ring
        0 0 0 (@header-icon-ring-size + 0.4rem) #fff,
        //  cast shadow
        0 5px 14px (@header-icon-ring-size + 0.4rem) rgba(0, 0, 0, 0.10);
}
.ui.header.wekb-pageHeader {
    display: flex;
    align-items: center;
    gap: 8px;
    > i.circular.inverted.icon {

        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 @header-icon-size;

        width: @header-icon-size !important;
        min-width: @header-icon-size;
        max-width: @header-icon-size;

        height: @header-icon-size !important;
        min-height: @header-icon-size;
        max-height: @header-icon-size;

        box-sizing: border-box;
        border-radius: 50% !important;

        padding: 0 !important;
        margin: 0;

        font-size: @header-icon-symbol-size;
        line-height: 1 !important;
        color: #fff !important;
    }

    > i.icon + .content {
        display: block;
        min-width: 0;
        padding-left: 0;
    }
}
// ****  Colors for icons at header ***** //
i.circular.inverted.wekb-glowIconHeader {
    &.wekb-package                      { .icon-color-header(@package); }
    &.wekb-titleinstancepackageplatform { .icon-color-header(@title); }
    &.wekb-platform                     { .icon-color-header(@platform); }
    &.wekb-provider                     { .icon-color-header(@provider); }
    &.wekb-vendor                       { .icon-color-header(@vendor); }
    &.wekb-org                          { .icon-color-header(@org); }
    &.wekb-default                      { .icon-color-header(@default); }
    &.wekb-setting                      { .icon-color-header(@default); }
    &.wekb-overview                     { .icon-color-header(@default); }
    &.wekb-info                         { .icon-color-header(@default); }
    &.wekb-kbartsource                  { .icon-color-header(@default); }
    &.wekb-source                       { .icon-color-header(@default); }
    &.wekb-curatorygroup                { .icon-color-header(@default); }
    &.wekb-refdatacategory              { .icon-color-header(@default); }
    &.wekb-library-supplier             { .icon-color-header(@default); }
}
// ****  Colors for icons on landing page ***** //
i.circular.inverted.wekb-glowIconLanding {
    &.wekb-package                          { .icon-color-landing(@package); }
    &.wekb-titleinstancepackageplatform     { .icon-color-landing(@title); }
    &.wekb-platform                         { .icon-color-landing(@platform); }
    &.wekb-provider                         { .icon-color-landing(@provider); }
}
