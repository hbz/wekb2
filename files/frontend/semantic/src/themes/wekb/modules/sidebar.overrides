// this toggles the burger button on and off
#sidebar-menu-button {
  display: none;
}
@media only screen and (max-width: 992px) {
  #sidebar-menu-button {
    display: flex !important;
  }
}
.wekb-content {
  padding-top: 5rem;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  background-color: #fff;

  background-image:
      radial-gradient(ellipse at 25% 45%, rgba(242, 113, 28, .09) 0, transparent 70%),
      radial-gradient(ellipse at 88% 42%, rgba(33, 133, 208, .08) 0, transparent 75%);
}
.shrink {
  padding-right: 260px!important;
}